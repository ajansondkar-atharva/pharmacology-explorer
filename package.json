{
  "name": "pharmacology-explorer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Offline-first pharmacology encyclopedia — structured drug monographs, interaction engine, PK visualizations, guidelines, and study tools.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:portable": "vite build --config vite.portable.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-data.mjs",
    "migrate": "node scripts/migrate-from-original.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^3.0.0"
  }
}
